<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Jellyfin.Plugin.SubscriptionManager</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.SubscriptionManager</RootNamespace>
    <Version>0.2.4.7</Version>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="12.4.0" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="12.4.0" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Database.Implementations" Version="12.4.0" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Configuration/config.html" />
    <EmbeddedResource Include="Configuration/SubscriptionManager.js" />
    <EmbeddedResource Include="Configuration/banner.js" />
  </ItemGroup>
</Project>
